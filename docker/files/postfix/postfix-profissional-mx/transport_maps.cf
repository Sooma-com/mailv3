query = SELECT 'lmtp:inet:' || imapserver || ':2525' FROM postfix.users WHERE username = lower('%u') and domain = lower('%d') UNION SELECT 'smtp:' || profissional_domain_secondary_target.target || ':25' FROM profissional_domains JOIN profissional_domain_secondary_target ON profissional_domains.id = profissional_domain_secondary_target.id WHERE profissional_domains.name = lower('%d')

