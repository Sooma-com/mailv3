    "-o",
    "plugin/quota=count:User quota:noenforcing",
    "-d",
    email
    ],
    stdin = subprocess.PIPE
    )
lda_process.communicate(input=get_warning_message(percentage, email).encode("utf-8"))
lda_process.wait()
