def usage():
    croak("Usage: profissional_user_quota_warn <percent> <email>", -1)

def croak(msg, returncode = -1):
    print(msg, file=sys.stderr)
    sys.exit(returncode)

def db_exec(query, *args):
    cursor = database.cursor(cursor_factory = psycopg2.extras.RealDictCursor)
    cursor.execute(query, args)
    cursor.close()

def fetch_all(query, *args):
    cursor = database.cursor(cursor_factory = psycopg2.extras.RealDictCursor)
    cursor.execute(query, args)
    rows = cursor.fetchall()
    cursor.close()
    return rows

try:
    database = psycopg2.connect(host="10.3.9.3",dbname="mail_profissional", user="postgres")
except psycopg2.DatabaseError as e:
    croak(e, -2)

