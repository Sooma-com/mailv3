def get_warning_message(quota, email):
    key = ""
    domain = email.split("@", 2)[1]
    if domain == "remax.pt":
        key += domain
    else:
        key += "default"
    key += ":"
    if quota >= 90:
        key += "very_high"
    else:
        key += "default"

    if key not in warningMessages:
        key = "default:default"

    message = "Date: %s" % (formatdate(localtime=True),)
    message += "\r\n"
    message += warningMessages[key]
    for needle,replacement in {"[domain]": domain, "[email]": email}.items():
        message = message.replace(needle,replacement)

    return message

