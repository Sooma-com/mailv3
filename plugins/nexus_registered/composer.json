{
    "name": "roundcube/nexus_registered",
    "type": "roundcube-plugin",
    "description": "Allows users to purchase registered mail accounts using Sooma Nexus",
    "license": "GPL-3.0-or-later",
    "version": "1.0",
    "authors": [
        {
            "name": "Sérgio Carvalho",
            "email": "daf@sooma.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=7.3.0",
        "roundcube/plugin-installer": ">=0.1.3"
    },
    "replace": {
        "roundcube/roundcubemail": "*"
    },
    "autoload": {
        "psr-4": {"Nexus\\": "lib/nexus_client/"}
    },
    "config": {
        "allow-plugins": {
            "roundcube/plugin-installer": true
        }
    }
}
