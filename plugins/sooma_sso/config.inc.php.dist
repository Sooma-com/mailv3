<?php

// Shared secret with the Sooma portals (portugalmail.pt, clix.pt,
// xekmail.pt, ...), used to authenticate/decrypt AES-256-GCM SSO
// tokens. Must be exactly 32 raw bytes, base64-encoded here.
//
// Generate one with:
//   openssl rand -base64 32
//
// The SAME value must be configured on every portal that hands users
// off to this webmail install. Treat it like any other credential -
// it is NOT committed to git (plugins/*/config.inc.php is gitignored).
$config['sooma_sso_key'] = '';

// Maximum age (seconds, either direction) tolerated between the
// token's embedded timestamp and this server's clock. Keep this short:
// it is the only replay protection this plugin has, since there is no
// shared store to track single-use tokens.
$config['sooma_sso_token_ttl'] = 30;

// Hostname or IP of the Sooma Directory server, with an optional :port
// (port 80 when omitted). Once per session, after login, the plugin
// GETs http://<address>/test_access/ and shows an Administration link
// to /directory/ only when the JSON boolean response is true.
$config['sooma_sso_directory_address'] = '';
