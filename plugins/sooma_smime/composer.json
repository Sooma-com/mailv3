{
    "name": "sooma/sooma_smime",
    "type": "roundcube-plugin",
    "description": "Plugin to provide security via S/MIME 4.0 standard (RFC 8551).",
    "license": "GPL-3.0-or-later",
    "version": "1.0",
    "authors": [
        {
            "name": "Sérgio Carvalho",
            "email": "daf@sooma.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.3.0",
        "roundcube/plugin-installer": ">=0.1.3"
    },
    "replace": {
        "roundcube/roundcubemail": "*"
    },
    "autoload": {
        "psr-4": {
            "Sooma\\Smime\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "roundcube/plugin-installer": true
        }
    }
}
